{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "1"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "video2ascii.nishantg.com"
        }
      ],
      "destination": "https://www.nishantg.com/skills/video2ascii",
      "permanent": false
    },
    {
      "source": "/skills/video-to-ascii",
      "destination": "/skills/video2ascii",
      "permanent": true
    },
    {
      "source": "/stash/:slug",
      "destination": "/skills/:slug",
      "permanent": true
    }
  ]
}
